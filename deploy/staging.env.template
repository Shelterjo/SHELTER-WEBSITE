# SHELTER — Staging environment (docs/platform/ENVIRONMENTS.md). Rendered ONCE by scripts/deploy/render-env.py into
# private_html/shelter/.env on the server; never committed with values, never printed. A double-brace placeholder = a GitHub secret or
# a key generated at first render. Staging: not indexed, behind basic auth, no outgoing mail, its own database.
APP_NAME="SHELTER COFFEE"
APP_ENV=staging
APP_KEY={{APP_KEY}}
APP_DEBUG=false
APP_URL={{APP_URL}}
APP_LOCALE=ar
APP_FALLBACK_LOCALE=ar
APP_TIMEZONE=UTC

SHELTER_INDEXING=false
SHELTER_RELEASE=staging
SHELTER_BASIC_AUTH_USER={{BASIC_AUTH_USER}}
SHELTER_BASIC_AUTH_PASSWORD={{BASIC_AUTH_PASSWORD}}
TRUSTED_PROXIES=127.0.0.1,::1

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=info

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE={{DB_DATABASE}}
DB_USERNAME={{DB_USERNAME}}
DB_PASSWORD={{DB_PASSWORD}}

SESSION_DRIVER=database
SESSION_LIFETIME=30
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE={{SESSION_SECURE_COOKIE}}
SESSION_SAME_SITE=lax
QUEUE_CONNECTION=database
CACHE_STORE=database
FILESYSTEM_DISK=local
MAIL_MAILER=log

RECRUITMENT_ID_KEY_VERSION=1
RECRUITMENT_ID_ENC_KEY={{RECRUITMENT_ID_ENC_KEY}}
RECRUITMENT_ID_HMAC_KEY={{RECRUITMENT_ID_HMAC_KEY}}
CAREERS_FORM_ENABLED=false

# AI provider: none until the Owner authorizes a paid provider (D-346/D-347). Backups: ops:backup-db, private folder.
AI_PROVIDER=none
