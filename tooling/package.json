{
  "name": "shelter-tooling",
  "private": true,
  "version": "0.1.0",
  "description": "SHELTER COFFEE — framework-agnostic quality and media tooling (tests, accessibility, Lighthouse, image pipeline). Not application code.",
  "type": "module",
  "engines": {
    "node": ">=22.19"
  },
  "scripts": {
    "test:e2e": "playwright test",
    "test:a11y": "playwright test --grep @a11y",
    "test:responsive": "playwright test --grep @responsive",
    "report": "playwright show-report reports/playwright",
    "lighthouse": "node scripts/lighthouse.mjs",
    "images:build": "node scripts/images.mjs",
    "images:selftest": "node scripts/images.mjs --selftest",
    "guard:selftest": "node scripts/base-url-guard.mjs --selftest",
    "qa": "npm run test:e2e; npm run qa:matrix && npm run lighthouse && npm run images:selftest && npm run guard:selftest",
    "qa:matrix": "node scripts/qa-matrix.mjs",
    "tokens:css": "node scripts/tokens-css.mjs",
    "ds:audit": "node scripts/ds-audit.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.56.1",
    "lighthouse": "13.5.0",
    "sharp": "0.35.5"
  }
}
