includes:
    - vendor/larastan/larastan/extension.neon

parameters:
    # TOOLCHAIN.md: strict static analysis for PHP (equivalent of TypeScript strict). No baseline, no blanket ignores.
    level: 8
    paths:
        - app
        - config
        - database
        - routes
        - tests
    tmpDir: storage/framework/cache/phpstan
    treatPhpDocTypesAsCertain: false
