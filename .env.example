# SHELTER — environment template (docs/platform/ENVIRONMENTS.md, docs/platform/DEPLOYMENT.md §10). Real values live only
# in each server's .env. Never commit secrets. Staging and Production each have their own APP_KEY, DB and credentials.
# The values below are for a laptop. [PROD] marks a value staging/production must set explicitly in its own .env.
# tests/Feature/Core/EnvExampleTest keeps this file in step with every env() the config reads.
APP_NAME="SHELTER COFFEE"
# [PROD] APP_ENV=production (staging: staging).
APP_ENV=local
# Secret, one per environment: php artisan key:generate --show
APP_KEY=
# Secret. Only while rotating APP_KEY: the old key(s), comma-separated, so sessions and encrypted values still open.
APP_PREVIOUS_KEYS=
# [PROD] APP_DEBUG=false. Staging and production never run in debug whatever this says (config/app.php, FINAL-QA QA-025).
APP_DEBUG=true
# No trailing slash. [PROD] the canonical https host (DB-11: www); staging uses its own https host.
APP_URL=http://localhost:8000

APP_LOCALE=ar
APP_FALLBACK_LOCALE=ar
APP_FAKER_LOCALE=en_US

# Indexing: only production with SHELTER_INDEXING=true is indexable. Staging sends noindex + robots disallow.
# [PROD] false until the launch approval, then true (production only, never staging).
SHELTER_INDEXING=false
# Public search: searches per minute per address (SEC-007). Keep 30; only a local QA run raises it.
SHELTER_SEARCH_PER_MINUTE=30
# Release channel for the brand guard (production refuses MISSING brand tokens). Build time only: the guard reads the
# shell that runs the build (SHELTER_RELEASE=production npm run build); a value in a server's .env changes nothing.
SHELTER_RELEASE=local
# Staging/dev HTTP basic auth in front of everything except /up (empty = off). Staging must set it; production: empty.
SHELTER_BASIC_AUTH_USER=
SHELTER_BASIC_AUTH_PASSWORD=
# The Owner dashboard's language (DASH-034: Arabic first).
DASHBOARD_LOCALE=ar

# Proxies whose X-Forwarded-For/-Proto/-Host are trusted (config/trustedproxy.php, read on every request).
# Comma-separated IP addresses and CIDR ranges, IPv4 and IPv6. Empty = 127.0.0.1,::1 (Cloudways: Nginx → Varnish →
# Apache on the same server). Behind Cloudflare: 127.0.0.1,::1 plus every range Cloudflare publishes at
# https://www.cloudflare.com/ips/ — that page is the source of truth; never type ranges from memory. Check on staging that
# the client address is the visitor's, not Cloudflare's. '*' trusts any peer: never on a publicly reachable server.
TRUSTED_PROXIES=127.0.0.1,::1

APP_MAINTENANCE_DRIVER=file
# Only with APP_MAINTENANCE_DRIVER=cache (several servers).
# APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
# [PROD] LOG_STACK=daily (one file a day, kept LOG_DAILY_DAYS days); "single" grows forever.
LOG_STACK=single
LOG_DAILY_DAYS=14
LOG_DEPRECATIONS_CHANNEL=null
# [PROD] LOG_LEVEL=warning (or stricter); debug is for a laptop (FINAL-QA QA-014).
LOG_LEVEL=debug

# Local/CI: sqlite (database/database.sqlite). [PROD] mysql or mariadb, matching the Cloudways engine, with the values
# from Cloudways → Application → Access details (separate databases for staging and production). DB_HOST, DB_PORT,
# DB_USERNAME and DB_PASSWORD are ignored while DB_CONNECTION=sqlite.
DB_CONNECTION=sqlite
DB_HOST=127.0.0.1
DB_PORT=3306
# SQLite: empty = database/database.sqlite (or an absolute file path). MySQL/MariaDB: the database name.
DB_DATABASE=
DB_USERNAME=
# Secret.
DB_PASSWORD=

SESSION_DRIVER=database
# [PROD] SESSION_LIFETIME=30: idle timeout in minutes (docs/platform/SECURITY-CENTER.md). The config default is 120.
SESSION_LIFETIME=30
SESSION_EXPIRE_ON_CLOSE=false
# [PROD] SESSION_ENCRYPT=true. The config default is false.
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
# Local only: staging and production always send the session cookie over HTTPS only (config/session.php). Leave it
# unset there; false only for local http.
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# Nothing is queued today (no worker needed); keep database.
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# V1: no outgoing email unless approved (docs/platform/NOTIFICATIONS.md). Staging must never reach real recipients.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@example.invalid"
MAIL_FROM_NAME="${APP_NAME}"

# Public forms on production (production gates; staging opens them whenever their prerequisites exist).
# [PROD] false until the Owner approves each one (careers: production gates + PO-019; feedback: PO-063).
CAREERS_FORM_ENABLED=false
FRANCHISE_FORM_ENABLED=false
FEEDBACK_FORM_ENABLED=false

# Careers (RECRUITMENT-SECURITY §5, CLOUDWAYS-RECRUITMENT-ARCHITECTURE). Set on the server only — never in git or chat.
# Identity keys: 32 random bytes each, base64 (php -r 'echo base64_encode(random_bytes(32)), PHP_EOL;').
# Losing a key = losing the ability to read the identity numbers it encrypted: the Owner keeps an offline copy.
RECRUITMENT_ID_KEY_VERSION=1
RECRUITMENT_ID_ENC_KEY=
RECRUITMENT_ID_ENC_KEYS_PREVIOUS=
RECRUITMENT_ID_HMAC_KEY=
# Private attachments outside the web root (Cloudways: …/private_html/recruitment). Empty = storage/app/private/careers.
CAREERS_STORAGE_ROOT=
# Explicit per-file limit after the Cloudways audit (A-07); empty = derived from PHP limits minus 10%.
CAREERS_MAX_FILE_BYTES=
# Files per application and their total size in bytes; empty = 20 files, 104857600 bytes (100 MB).
CAREERS_MAX_FILES=
CAREERS_MAX_TOTAL_BYTES=

# Media library (MEDIA-RIGHTS). Originals: private, never served (Cloudways: …/private_html/media); empty =
# storage/app/private/media. Web copies of approved images: keep empty (= public/media, served at /media/) and make
# public/media a symlink to a shared folder so it survives releases; a root outside public/ breaks the /media/ URLs.
MEDIA_STORAGE_ROOT=
MEDIA_PUBLIC_ROOT=

# Database backups by the app (ops:backup-db: daily at 03:00 Amman and before every deploy — DEPLOYMENT.md §5).
# Private folder, never under public/ (Cloudways: …/private_html/backups); empty = storage/app/private/backups.
BACKUP_ROOT=
# How many backups to keep, newest first; empty = 14.
BACKUP_KEEP=14
# MySQL/MariaDB dump program; empty = mysqldump (MariaDB also ships mariadb-dump).
BACKUP_MYSQLDUMP=

# AI provider for شلتور (M69) and the Owner AI assistant (M70) — config/ai.php. PAID SERVICE: nothing is connected until
# the Owner authorizes a provider (D-346/D-347, PO pending). "none" = both assistants answer from site data only.
# The key is a server secret: set it on the server only — never in git, chat, HTML, JavaScript or a browser response.
AI_PROVIDER=none
AI_ANTHROPIC_KEY=
AI_ANTHROPIC_MODEL=claude-haiku-4-5-20251001
AI_TIMEOUT=12
# Daily call ceilings (cost control); past them the assistants answer without AI.
AI_SHALTOOR_DAILY_LIMIT=300
AI_OWNER_DAILY_LIMIT=60

# ── Optional: read by Laravel's stock config; the defaults are right for this app. Leave them unset. ──
# AUTH_GUARD AUTH_MODEL AUTH_PASSWORD_BROKER AUTH_PASSWORD_RESET_TOKEN_TABLE AUTH_PASSWORD_TIMEOUT
# DB_URL DB_SOCKET DB_CHARSET DB_COLLATION DB_FOREIGN_KEYS DB_ENCRYPT DB_SSLMODE DB_TRUST_SERVER_CERTIFICATE MYSQL_ATTR_SSL_CA
# DB_CACHE_CONNECTION DB_CACHE_TABLE DB_CACHE_LOCK_CONNECTION DB_CACHE_LOCK_TABLE CACHE_STORAGE_DISK CACHE_STORAGE_PATH
# DB_QUEUE DB_QUEUE_CONNECTION DB_QUEUE_TABLE DB_QUEUE_RETRY_AFTER QUEUE_FAILED_DRIVER
# SESSION_COOKIE SESSION_HTTP_ONLY SESSION_PARTITIONED_COOKIE SESSION_CONNECTION SESSION_TABLE SESSION_STORE
# LOG_DEPRECATIONS_TRACE LOG_SLACK_WEBHOOK_URL LOG_SLACK_USERNAME LOG_SLACK_EMOJI PAPERTRAIL_URL PAPERTRAIL_PORT
# LOG_PAPERTRAIL_HANDLER LOG_STDERR_FORMATTER LOG_SYSLOG_FACILITY
# MAIL_URL MAIL_EHLO_DOMAIN MAIL_LOG_CHANNEL MAIL_SENDMAIL_PATH POSTMARK_API_KEY POSTMARK_MESSAGE_STREAM_ID RESEND_API_KEY
# SLACK_BOT_USER_OAUTH_TOKEN SLACK_BOT_USER_DEFAULT_CHANNEL
# MEMCACHED_HOST MEMCACHED_PORT MEMCACHED_USERNAME MEMCACHED_PASSWORD MEMCACHED_PERSISTENT_ID
# DYNAMODB_CACHE_TABLE DYNAMODB_ENDPOINT
# REDIS_URL REDIS_USERNAME REDIS_DB REDIS_CACHE_DB REDIS_PREFIX REDIS_CLUSTER REDIS_PERSISTENT REDIS_MAX_RETRIES
# REDIS_BACKOFF_ALGORITHM REDIS_BACKOFF_BASE REDIS_BACKOFF_CAP REDIS_CACHE_CONNECTION REDIS_CACHE_LOCK_CONNECTION
# REDIS_QUEUE REDIS_QUEUE_CONNECTION REDIS_QUEUE_RETRY_AFTER
# BEANSTALKD_QUEUE BEANSTALKD_QUEUE_HOST BEANSTALKD_QUEUE_RETRY_AFTER SQS_PREFIX SQS_QUEUE SQS_SUFFIX
# AWS_ACCESS_KEY_ID AWS_SECRET_ACCESS_KEY AWS_DEFAULT_REGION AWS_BUCKET AWS_URL AWS_ENDPOINT AWS_USE_PATH_STYLE_ENDPOINT
# Not read by anything (removed from this file): APP_TIMEZONE (the app runs in UTC; Amman times are explicit in code)
# and VITE_APP_NAME (no script reads it).
