# SHELTER — environment template (docs/platform/ENVIRONMENTS.md). Real values live only in each server's .env.
# Never commit secrets. Staging and Production each have their own APP_KEY, DB and credentials.
APP_NAME="SHELTER COFFEE"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# No trailing slash.
APP_URL=http://localhost:8000

APP_LOCALE=ar
APP_FALLBACK_LOCALE=ar
APP_FAKER_LOCALE=en_US
APP_TIMEZONE=UTC

# Indexing: only production with SHELTER_INDEXING=true is indexable. Staging sends noindex + robots disallow.
SHELTER_INDEXING=false
# Release channel used by the brand guard (production refuses MISSING brand tokens).
SHELTER_RELEASE=local
# Staging/dev HTTP basic auth in front of everything (empty = off). Staging must set it.
SHELTER_BASIC_AUTH_USER=
SHELTER_BASIC_AUTH_PASSWORD=

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Local/CI: SQLite. Staging/Production: MySQL/MariaDB on Cloudways (separate databases).
DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=shelter
# DB_USERNAME=shelter
# DB_PASSWORD=

SESSION_DRIVER=database
# Idle timeout in minutes (docs/platform/SECURITY-CENTER.md).
SESSION_LIFETIME=30
SESSION_EXPIRE_ON_CLOSE=false
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# V1: no outgoing email unless approved (docs/platform/NOTIFICATIONS.md). Staging must never reach real recipients.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@example.invalid"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
