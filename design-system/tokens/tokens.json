{
  "$description": "SHELTER design tokens — single source for Website, Owner Dashboard and future app (W3C DTCG). STRUCTURAL values (spacing, radius, type scale, motion, shadows, z-index, breakpoints, sizes) are technical decisions made under the owner's delegation (M29 §94, M34) and may be tuned in visual design. BRAND values (fonts, colour values) are MISSING until the brand identity files arrive (M-10 / PO-002): the 'wireframe' values below are neutral grayscale placeholders for low-fi prototypes ONLY and must never ship.",
  "$version": "0.1.0",
  "font": {
    "family": {
      "ar": { "$type": "fontFamily", "$value": ["BRAND-AR-FONT (MISSING)", "Noto Sans Arabic", "Segoe UI", "Tahoma", "system-ui", "sans-serif"] },
      "en": { "$type": "fontFamily", "$value": ["BRAND-EN-FONT (MISSING)", "system-ui", "-apple-system", "Segoe UI", "Roboto", "sans-serif"] },
      "wireframe": { "$type": "fontFamily", "$value": ["DejaVu Sans", "system-ui", "sans-serif"] }
    },
    "size": {
      "xs": { "$value": "0.75rem", "$description": "12px — minimum UI text (captions, badges)" },
      "sm": { "$value": "0.875rem", "$description": "14px" },
      "base": { "$value": "1rem", "$description": "16px — body; never smaller on mobile body copy" },
      "lg": { "$value": "1.125rem", "$description": "18px" },
      "xl": { "$value": "1.25rem", "$description": "20px" },
      "2xl": { "$value": "1.5rem", "$description": "24px" },
      "3xl": { "$value": "clamp(1.625rem, 1.3rem + 1.2vw, 1.875rem)", "$description": "26→30px fluid" },
      "4xl": { "$value": "clamp(1.75rem, 1.3rem + 2vw, 2.25rem)", "$description": "28→36px fluid" },
      "5xl": { "$value": "clamp(2rem, 1.4rem + 3vw, 3rem)", "$description": "32→48px fluid — hero only" }
    },
    "weight": { "regular": { "$value": 400 }, "medium": { "$value": 500 }, "bold": { "$value": 700 } },
    "lineHeight": {
      "tight": { "$value": 1.25, "$description": "headings" },
      "normal-en": { "$value": 1.5 },
      "normal-ar": { "$value": 1.7, "$description": "Arabic needs more vertical room for diacritics and descenders" }
    },
    "letterSpacing": {
      "en-caps": { "$value": "0.02em", "$description": "Latin ALL CAPS only (product/category names)" },
      "ar": { "$value": "0", "$description": "RULE: never letter-space Arabic — it breaks letter joining" }
    },
    "measure": { "reading": { "$value": "68ch", "$description": "max readable line length for articles/paragraphs on desktop" } }
  },
  "space": {
    "$description": "4px base scale. margin/padding/gap use ONLY these.",
    "0": { "$value": "0" }, "1": { "$value": "4px" }, "2": { "$value": "8px" }, "3": { "$value": "12px" }, "4": { "$value": "16px" },
    "5": { "$value": "20px" }, "6": { "$value": "24px" }, "8": { "$value": "32px" }, "10": { "$value": "40px" }, "12": { "$value": "48px" },
    "16": { "$value": "64px" }, "20": { "$value": "80px" }
  },
  "radius": {
    "$description": "Rounded, never harsh (owner direction). PRIMARY brand radius = md for controls; lg for cards; xl for sheets/modals.",
    "sm": { "$value": "6px", "$description": "badges, small chips inside dense tables" },
    "md": { "$value": "10px", "$description": "PRIMARY — buttons, inputs, selects, segmented controls" },
    "lg": { "$value": "14px", "$description": "cards, panels, images in cards" },
    "xl": { "$value": "20px", "$description": "bottom sheets (top corners), modals, hero media" },
    "pill": { "$value": "999px", "$description": "chips/tags only" }
  },
  "border": {
    "width": { "default": { "$value": "1px" }, "strong": { "$value": "1.5px" } },
    "focus": { "$value": "3px solid var(--color-focus)", "$description": "offset 2px; ≥3:1 contrast; never removed" }
  },
  "shadow": {
    "$description": "clean / subtle / premium — no glow",
    "none": { "$value": "none" },
    "sm": { "$value": "0 1px 2px rgb(0 0 0 / 0.06)" },
    "md": { "$value": "0 4px 12px rgb(0 0 0 / 0.08)" },
    "lg": { "$value": "0 12px 32px rgb(0 0 0 / 0.12)", "$description": "modals/sheets only" }
  },
  "motion": {
    "duration": { "fast": { "$value": "120ms" }, "normal": { "$value": "200ms" }, "slow": { "$value": "320ms" } },
    "easing": {
      "standard": { "$value": "cubic-bezier(0.2, 0, 0, 1)" },
      "enter": { "$value": "cubic-bezier(0, 0, 0.2, 1)" },
      "exit": { "$value": "cubic-bezier(0.4, 0, 1, 1)" }
    },
    "reduced": { "$value": "0ms", "$description": "prefers-reduced-motion: instant state changes, static alternatives" }
  },
  "size": {
    "touchTarget": { "$value": "44px" },
    "control": { "sm": { "$value": "36px", "$description": "desktop dense tables only (pointer: fine)" }, "md": { "$value": "44px" }, "lg": { "$value": "52px" } },
    "icon": { "sm": { "$value": "16px" }, "md": { "$value": "20px" }, "lg": { "$value": "24px" }, "stroke": { "$value": 1.75, "$description": "Lucide only — one icon library" } },
    "container": {
      "page": { "$value": "1280px" }, "dashboard": { "$value": "1440px" }, "reading": { "$value": "720px" },
      "modal": { "$value": "760px", "$description": "desktop modal max width (Menu IA spec §7 product detail)" },
      "drawer": { "$value": "400px", "$description": "side sheet / drawer max width" },
      "sidebar": { "$value": "240px", "$description": "desktop side navigation width (Menu IA spec §11 side list; dashboard shell)" },
      "narrow": { "$value": "480px", "$description": "single-task forms (owner sign-in, two-step verification, confirm identity)" },
      "gutter-mobile": { "$value": "16px" }, "gutter-tablet": { "$value": "24px" }, "gutter-desktop": { "$value": "32px" }
    },
    "stickyStack": { "$value": "112px", "$description": "menu category + subcategory bars (R-03); short viewports keep 56px (R-09)" }
  },
  "breakpoint": {
    "$description": "Content-based (Menu IA R-01). Use container queries inside components where useful; no device-name targeting.",
    "sm": { "$value": "360px" }, "md": { "$value": "600px" }, "lg": { "$value": "1024px" }, "xl": { "$value": "1200px" }, "short-height": { "$value": "500px", "$description": "max-height query (R-09)" }
  },
  "z": {
    "base": { "$value": 0 }, "sticky": { "$value": 20 }, "header": { "$value": 30 }, "dropdown": { "$value": 40 },
    "overlay": { "$value": 50 }, "modal": { "$value": 60 }, "toast": { "$value": 70 }, "safeMode": { "$value": 80 }
  },
  "color": {
    "$description": "Semantic roles. Brand values MISSING (M-10). 'wireframe' = neutral placeholders for low-fi prototypes only (all text pairs ≥4.5:1).",
    "bg":       { "brand": { "$value": "MISSING" }, "wireframe": { "$value": "#ffffff" } },
    "surface":  { "brand": { "$value": "MISSING" }, "wireframe": { "$value": "#f7f7f7" } },
    "text":     { "brand": { "$value": "MISSING" }, "wireframe": { "$value": "#1a1a1a" } },
    "muted":    { "brand": { "$value": "MISSING" }, "wireframe": { "$value": "#595959" } },
    "border":   { "brand": { "$value": "MISSING" }, "wireframe": { "$value": "#cccccc" } },
    "accent":   { "brand": { "$value": "MISSING" }, "wireframe": { "$value": "#111111" } },
    "on-accent":{ "brand": { "$value": "MISSING" }, "wireframe": { "$value": "#ffffff" } },
    "focus":    { "brand": { "$value": "MISSING" }, "wireframe": { "$value": "#111111" } },
    "success":  { "brand": { "$value": "MISSING" }, "wireframe": { "$value": "#1d6b35" } },
    "warning":  { "brand": { "$value": "MISSING" }, "wireframe": { "$value": "#7a5200" } },
    "danger":   { "brand": { "$value": "MISSING" }, "wireframe": { "$value": "#a1271e" } },
    "info":     { "brand": { "$value": "MISSING" }, "wireframe": { "$value": "#1f4f8a" } },
    "scrim":    { "brand": { "$value": "MISSING" }, "wireframe": { "$value": "rgb(0 0 0 / 0.5)" }, "$description": "modal/sheet backdrop; 40–60% dim (ACCESSIBILITY-CHECKLIST, confirmed in visual design)" }
  }
}
